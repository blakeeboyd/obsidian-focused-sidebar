{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES6",
		"lib": ["DOM", "ES5", "ES6", "ES7"],
		"moduleResolution": "node",
		"allowJs": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"outDir": "./dist",
		"sourceMap": true,
		"importHelpers": false,
		"isolatedModules": true
	},
	"include": ["src/**/*.ts"]
}
